# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth: gere com `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Discord (https://discord.com/developers/applications → OAuth2)
# Redirect: <site>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# IDs do Discord (separados por vírgula) que sempre têm acesso ao painel /admin.
# Líder e vice ativos no site também viram admin automaticamente.
ADMIN_DISCORD_IDS=
